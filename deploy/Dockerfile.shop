# The billing and persona layer. No GPU, no model weights -- it talks to vLLM.
FROM node:22-slim

WORKDIR /app/agent
COPY agent/package.json agent/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm i -D tsx typescript @types/node --no-audit --no-fund

COPY agent/tsconfig.json ./
COPY agent/src ./src
# model/ is bind-mounted at run time so a catalog edit does not need a rebuild.

ENV SERVE_HOST=0.0.0.0 SERVE_PORT=8080
EXPOSE 8080
CMD ["npx", "tsx", "src/serve-main.ts"]
