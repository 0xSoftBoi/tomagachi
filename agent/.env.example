# --- required -----------------------------------------------------------
# Operator wallet: the creature's brain. Signs buyCompute/checkpoint/feedFor
# and Suwappu self-custody swaps. Needs a little ETH on Base for gas.
OPERATOR_KEY=0x...

# --- deploy-time (scripts/deploy.ts) ------------------------------------
DEPLOYER_KEY=0x...
# CHAIN=base            # or baseSepolia
# CREATURE_NAME=Suwa

# --- chain --------------------------------------------------------------
# RPC_URL=https://mainnet.base.org

# --- suwappu ------------------------------------------------------------
# SUWAPPU_API=https://api.suwappu.bot/v1/agent
# AGENT_NAME=suwappu-tomagachi
# Donated tokens the brain sweeps and swaps to USDC via Suwappu:
# SWEEP_TOKENS=WETH,DEGEN,AERO
# SWEEP_MIN_USD=1

# --- compute ------------------------------------------------------------
# COMPUTE_PROVIDER=local            # local (bootstrap, free) | remote
# COMPUTE_ENDPOINT=https://gpu-worker.example.com
# COMPUTE_API_KEY=...
# COMPUTE_PAY_TO=0x...              # provider's USDC address on Base
# COMPUTE_PRICE_USDC=2000000        # 2 USDC per run (6dp)
# MIN_ENERGY_TO_TRAIN=1000000       # don't train below 1 USDC energy

# --- training -----------------------------------------------------------
# What the creature trains with its food. "adapter" = a character LoRA (the
# product); "world" = SUWA-WM, the Reef world model (the dream).
# TRAIN_TARGET=adapter
# CHARACTER_ROTATION=suwa-tide,suwa-abyss   # default: every SKU in the catalog
# STEPS_PER_ADAPTER_EPOCH=300
# TINY_BACKBONE=1                   # byte-level local backbone; smoke test only
# STEPS_PER_EPOCH=2000              # world-model epochs, when TRAIN_TARGET=world
# TICK_MS=300000
# Bootstrap a SKU's dataset from any OpenAI-compatible teacher:
# TEACHER_URL=https://openrouter.ai/api/v1
# TEACHER_MODEL=...
# TEACHER_KEY=...

# --- serving: the shop (src/serve.ts) -----------------------------------
# The endpoint routers call. Needs /v1/models, streaming, and usage — all three
# are implemented; see research/operating-plan.md for why this is the revenue.
# SERVE_PORT=8080
# SERVE_HOST=0.0.0.0
# SERVE_API_KEY=...                 # bearer a router presents; unset => open
# SERVE_CONTEXT_LENGTH=32768
# SERVE=0                           # run the brain without the shop
# The GPU underneath: any OpenAI-compatible server (vLLM with one LoRA per SKU).
# UPSTREAM_BASE_URL=http://localhost:8000/v1
# UPSTREAM_API_KEY=...
# UPSTREAM_MODEL=...                # force one model name instead of per-adapter
# SUWA_PERSONA=merge                # merge | override | off
# Cost model behind GET /metrics (defaults match research/unit_economics.py):
# GPU_USD_PER_HOUR=2
# GPU_COUNT=1
# PREFILL_TOKENS_PER_SEC=20000
# DECODE_TOKENS_PER_SEC=2000

# --- provider manifest (GET /provider/models) ---------------------------
# What a router reads to decide what we sell. Schema 2.4 -- NOT the OpenAI
# /v1/models shape. See deploy/openrouter-application.md.
# PROVIDER_SLUG=suwappu             # ids become suwappu/suwa-tide
# PROVIDER_NAME=Suwappu
# PROVIDER_IS_READY=0               # 1 makes models visible. Flip deliberately.
# SERVED_QUANTIZATION=bf16          # must match how vLLM was launched
# MODELS_CREATED_AT=1787000000      # set once at first listing, then leave it
# SERVE_MAX_OUTPUT_TOKENS=4096
# CAPACITY_REQUESTS_PER_MINUTE=600  # past this we return 429, tracked apart from uptime
# DATACENTERS=US:us-east-1          # ISO 3166-1 alpha-2[:region], comma separated
# DEPLOYMENT_REGION=US
# COMPLIANCE_ZDR=0                  # keep 0 while memory.ts persists session facts

# --- open-source release ------------------------------------------------
# Weights go Apache-2.0 on a 90-day lag (model/characters.json). Setting
# HF_REPO makes the brain push on every epoch — only do that for a repo you
# intend to release immediately.
# HF_REPO=suwappu/suwa-lm
# HF_TOKEN=hf_...
