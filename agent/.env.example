# The creature has no operator and no admin key. This wallet is just a
# participant: it stakes on jobs and pokes public functions. It holds NO
# authority over the creature's treasury.
PRIVATE_KEY=0x...

# --- chain --------------------------------------------------------------
# RPC_URL=https://mainnet.base.org
# CHAIN=base                       # deploy only: base | baseSepolia

# --- roles (both permissionless, both optional) -------------------------
# RUN_KEEPER=true                  # claim its PumpClaw fees, open epochs
# RUN_WORKER=true                  # claim epochs, train, submit, collect
# POLL_MS=60000

# --- worker economics ---------------------------------------------------
# MIN_BOUNTY_WEI=1000000000000000  # refuse jobs cheaper than your compute
# STAKE_WEI=                       # defaults to the contract minimum

# --- open-weight release (REQUIRED for real epochs) ---------------------
# Without this, releases are tagged run:// and nobody else can fetch or
# verify your weights — which also blocks the next epoch's warm start.
# HF_REPO=suwappu/suwa-wm
# HF_TOKEN=hf_...

# --- treasury desk (optional) -------------------------------------------
# Convert bounty winnings to USDC via Suwappu to pay for GPU time.
# CASH_OUT_ABOVE_WEI=50000000000000000   # keep 0.05 ETH for gas, swap the rest
# SUWAPPU_API=https://api.suwappu.bot/v1/agent
# AGENT_NAME=tomagachi-worker

# --- deploy-time only ---------------------------------------------------
# NAME="Suwappu Tomagachi"
# SYMBOL=SUWA
# SUPPLY=1000000000
# FDV_ETH=2
# IMAGE_URL=
# SITE=https://suwappu.bot
# METABOLISM_ETH=0.01              # satiety burned per day
# MAX_SATIETY_ETH=1                # a full belly
# SKIP_HATCH=1                     # deploy without launching the token
